<Window x:Class="ExcelMailMerge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ExcelMailMerge"
        xmlns:m="clr-namespace:ExcelMailMerge.Models"
        xmlns:cv="clr-namespace:ExcelMailMerge.Converters"
        mc:Ignorable="d"
        Title="Excel邮件合并工具（支持Office / WPS）" Height="860" Width="1320"
        WindowStartupLocation="CenterScreen" Background="#F5F6FA"
        FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <cv:ListContainsConverter x:Key="ListContainsConv"/>
        <cv:UsedIconConverter x:Key="UsedIconConv"/>
        <cv:BoolToColorConverter x:Key="BoolColorConv"/>
        <cv:EnumEqualityConverter x:Key="EnumEqConv"/>
        <cv:BoolToVisibilityConverter x:Key="BoolVisConv"/>
        <cv:StepToVisibilityConverter x:Key="StepVisConv"/>
        <cv:StepStatusToBrushConverter x:Key="StepBrushConv"/>
        <cv:StepStatusToTextConverter x:Key="StepTextConv"/>
        <cv:InverseBoolToVisibilityConverter x:Key="InvBoolVisConv"/>

        <!-- 主按钮（琥珀金） -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Background" Value="#D4A256"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#B87333"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#E5E7EB"/>
                                <Setter Property="Foreground" Value="#9CA3AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 次按钮（白底边框） -->
        <Style x:Key="SecondaryBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="BorderBrush" Value="#D0D5DD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FDFBF5"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#D4A256"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#F5F6FA"/>
                                <Setter Property="Foreground" Value="#9CA3AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 强调按钮（蓝） -->
        <Style x:Key="AccentBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2563EB"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#E5E7EB"/>
                                <Setter Property="Foreground" Value="#9CA3AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 成功按钮（绿） -->
        <Style x:Key="SuccessBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#059669"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#E5E7EB"/>
                                <Setter Property="Foreground" Value="#9CA3AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 步骤导航圆圈 -->
        <Style x:Key="StepCircle" TargetType="Border">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{Binding Status, Converter={StaticResource StepBrushConv}}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 卡片 -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderBrush" Value="#E8EAF0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>

        <!-- 卡片头 -->
        <Style x:Key="CardHeader" TargetType="Border">
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Background" Value="#FAF8F3"/>
            <Setter Property="BorderBrush" Value="#E8EAF0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="BorderBrush" Value="#D0D5DD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,3"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="RowHeight" Value="26"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="AlternatingRowBackground" Value="#F9FAFB"/>
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#1A2540"/>
                        <Setter Property="Foreground" Value="#D4A256"/>
                        <Setter Property="FontWeight" Value="Medium"/>
                        <Setter Property="Padding" Value="8,4"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 标题栏 -->
            <RowDefinition Height="Auto"/>   <!-- 步骤导航 -->
            <RowDefinition Height="*"/>       <!-- 内容区 -->
            <RowDefinition Height="Auto"/>   <!-- 底部操作栏 -->
        </Grid.RowDefinitions>

        <!-- ========== 标题栏 ========== -->
        <Border Grid.Row="0" Background="#1A2540" CornerRadius="6" Padding="16,10" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="26" Height="26" CornerRadius="6" Background="#D4A256" Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="E" Foreground="#1A2540" FontWeight="Bold" FontSize="15"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Grid.Column="1" Text="Excel 邮件合并工具" FontSize="17" FontWeight="SemiBold" Foreground="#F0E6D2" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="（支持 Office / WPS · xlsx）" FontSize="12" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="10,0,0,0"/>
                <TextBlock Grid.Column="4" Text="📌 excel格式模板快速生成工具" FontSize="11" Foreground="#D4A256" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ========== 步骤导航 ========== -->
        <Border Grid.Row="1" Background="White" CornerRadius="6" Padding="20,12" Margin="0,0,0,8" BorderBrush="#E8EAF0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- 进度线（背景） -->
                <Border Grid.Column="0" Grid.ColumnSpan="4" VerticalAlignment="Center" Height="2" Background="#E8EAF0" Margin="80,18,80,18"/>

                <!-- 数据源 -->
                <StackPanel Grid.Column="0" Orientation="Vertical" HorizontalAlignment="Center">
                    <Border Style="{StaticResource StepCircle}">
                        <TextBlock Text="{Binding StepItems[0].Status, Converter={StaticResource StepTextConv}, ConverterParameter=1}"
                                   Foreground="{Binding StepItems[0].Status, Converter={StaticResource StepBrushConv}}" FontWeight="Bold" FontSize="15"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="数据源" FontSize="13" FontWeight="Medium" Margin="0,6,0,0" HorizontalAlignment="Center"
                               Foreground="{Binding StepItems[0].Status, Converter={StaticResource StepBrushConv}}"/>
                    <TextBlock Text="上传并校验" FontSize="10" Foreground="#9CA3AF" HorizontalAlignment="Center"/>
                </StackPanel>
                <!-- 模板 -->
                <StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Center">
                    <Border Style="{StaticResource StepCircle}">
                        <TextBlock Text="{Binding StepItems[1].Status, Converter={StaticResource StepTextConv}, ConverterParameter=2}"
                                   Foreground="{Binding StepItems[1].Status, Converter={StaticResource StepBrushConv}}" FontWeight="Bold" FontSize="15"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="模板" FontSize="13" FontWeight="Medium" Margin="0,6,0,0" HorizontalAlignment="Center"
                               Foreground="{Binding StepItems[1].Status, Converter={StaticResource StepBrushConv}}"/>
                    <TextBlock Text="编辑占位符" FontSize="10" Foreground="#9CA3AF" HorizontalAlignment="Center"/>
                </StackPanel>
                <!-- 预览 -->
                <StackPanel Grid.Column="2" Orientation="Vertical" HorizontalAlignment="Center">
                    <Border Style="{StaticResource StepCircle}">
                        <TextBlock Text="{Binding StepItems[2].Status, Converter={StaticResource StepTextConv}, ConverterParameter=3}"
                                   Foreground="{Binding StepItems[2].Status, Converter={StaticResource StepBrushConv}}" FontWeight="Bold" FontSize="15"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="预览" FontSize="13" FontWeight="Medium" Margin="0,6,0,0" HorizontalAlignment="Center"
                               Foreground="{Binding StepItems[2].Status, Converter={StaticResource StepBrushConv}}"/>
                    <TextBlock Text="试生成确认" FontSize="10" Foreground="#9CA3AF" HorizontalAlignment="Center"/>
                </StackPanel>
                <!-- 生成 -->
                <StackPanel Grid.Column="3" Orientation="Vertical" HorizontalAlignment="Center">
                    <Border Style="{StaticResource StepCircle}">
                        <TextBlock Text="{Binding StepItems[3].Status, Converter={StaticResource StepTextConv}, ConverterParameter=4}"
                                   Foreground="{Binding StepItems[3].Status, Converter={StaticResource StepBrushConv}}" FontWeight="Bold" FontSize="15"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="生成" FontSize="13" FontWeight="Medium" Margin="0,6,0,0" HorizontalAlignment="Center"
                               Foreground="{Binding StepItems[3].Status, Converter={StaticResource StepBrushConv}}"/>
                    <TextBlock Text="全部生成" FontSize="10" Foreground="#9CA3AF" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========== 内容区（四阶段切换） ========== -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,0,4">
            <Grid>
                <!-- ① 数据源阶段 -->
                <Border Visibility="{Binding CurrentStep, Converter={StaticResource StepVisConv}, ConverterParameter={x:Static m:WizardStep.DataSource}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 上传 + Sheet配置 -->
                        <Border Style="{StaticResource Card}" Grid.Row="0">
                            <StackPanel>
                                <Border Style="{StaticResource CardHeader}">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="20" Height="20" CornerRadius="10" Background="#1A2540">
                                            <TextBlock Text="1" Foreground="#D4A256" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="上传数据源" FontSize="13" FontWeight="SemiBold" Foreground="#1A2540" Margin="8,0,0,0"/>
                                        <TextBlock Text="支持拖放 xlsx 文件到此区域" FontSize="11" Foreground="#9CA3AF" Margin="12,0,0,0"/>
                                    </StackPanel>
                                </Border>
                                <StackPanel Margin="14,10" AllowDrop="True" Drop="DataSource_Drop">
                                    <DockPanel LastChildFill="True" Margin="0,4">
                                        <Button DockPanel.Dock="Right" Content="📂 浏览…" Command="{Binding BrowseDataSourceCmd}" Style="{StaticResource SecondaryBtn}" Margin="8,0,0,0"/>
                                        <Button DockPanel.Dock="Right" Content="🔄 刷新Sheet" Command="{Binding RefreshDataSourceSheetsCmd}" Style="{StaticResource SecondaryBtn}" Margin="8,0,0,0"/>
                                        <TextBox Text="{Binding DataSourceFilePath, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" Background="#F9FAFB"/>
                                    </DockPanel>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="120"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="选择Sheet：" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding DataSourceSheets}" SelectedItem="{Binding SelectedSheet}" DisplayMemberPath="SheetName"/>
                                        <TextBlock Grid.Column="3" Text="标题行号：" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="4" Text="{Binding TitleRowIndex, UpdateSourceTrigger=LostFocus}" PreviewTextInput="NumberOnly_PreviewTextInput"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 列名清单 + 校验结果 -->
                        <Grid Grid.Row="1" Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- 校验结果 -->
                            <Border Style="{StaticResource Card}" Grid.Column="0" Margin="0,0,0,0">
                                <StackPanel>
                                    <Border Style="{StaticResource CardHeader}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🔍 数据源校验" FontSize="12" FontWeight="SemiBold" Foreground="#1A2540"/>
                                            <TextBlock Text="{Binding DataSourceIssues.SummaryText}" FontSize="11" Foreground="#6B7280" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <DataGrid ItemsSource="{Binding DataSourceIssues.Issues}" Height="140" Margin="6,4" HeadersVisibility="Column" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="级别" Binding="{Binding LevelText}" MinWidth="60"/>
                                            <DataGridTextColumn Header="位置" Binding="{Binding LocationText}" MinWidth="80"/>
                                            <DataGridTextColumn Header="问题" Binding="{Binding Message}" MinWidth="180"/>
                                            <DataGridTextColumn Header="建议修复" Binding="{Binding Suggestion}" MinWidth="120"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- 数据预览 -->
                        <Border Style="{StaticResource Card}" Grid.Row="2" Margin="0,4,0,0">
                            <StackPanel>
                                <Border Style="{StaticResource CardHeader}">
                                    <TextBlock Text="📊 数据预览（前5行）" FontSize="12" FontWeight="SemiBold" Foreground="#1A2540"/>
                                </Border>
                                <DataGrid x:Name="PreviewDataGrid" ItemsSource="{Binding PreviewRows}" Margin="6,4" Height="180"
                                          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                          HeadersVisibility="All" GridLinesVisibility="All">
                                    <DataGrid.RowHeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding RowLabel}" Padding="4" FontSize="11" Foreground="#6B7280"/>
                                        </DataTemplate>
                                    </DataGrid.RowHeaderTemplate>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ② 模板阶段 -->
                <Border Visibility="{Binding CurrentStep, Converter={StaticResource StepVisConv}, ConverterParameter={x:Static m:WizardStep.Template}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 上传模板 -->
                        <Border Style="{StaticResource Card}" Grid.Row="0">
                            <StackPanel>
                                <Border Style="{StaticResource CardHeader}">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="20" Height="20" CornerRadius="10" Background="#1A2540">
                                            <TextBlock Text="2" Foreground="#D4A256" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="上传模板" FontSize="13" FontWeight="SemiBold" Foreground="#1A2540" Margin="8,0,0,0"/>
                                        <TextBlock Text="用户上传已有模板，仅修改占位符" FontSize="11" Foreground="#9CA3AF" Margin="12,0,0,0"/>
                                    </StackPanel>
                                </Border>
                                <StackPanel Margin="14,10" AllowDrop="True" Drop="Template_Drop">
                                    <DockPanel LastChildFill="True" Margin="0,4">
                                        <Button DockPanel.Dock="Right" Content="✨ 编辑模板" Command="{Binding OpenTemplateEditorCmd}" Style="{StaticResource PrimaryBtn}" Margin="8,0,0,0"/>
                                        <Button DockPanel.Dock="Right" Content="📂 浏览…" Command="{Binding BrowseTemplateCmd}" Style="{StaticResource SecondaryBtn}" Margin="8,0,0,0"/>
                                        <TextBox Text="{Binding TemplateFilePath, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" Background="#F9FAFB"/>
                                    </DockPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="模板 Sheet 数：" FontSize="12" Foreground="#6B7280" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding ScannedTemplate.SheetCount, StringFormat={}{0} 个}" FontSize="12" FontWeight="SemiBold" Foreground="#1A2540" Margin="6,0,20,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="占位符数：" FontSize="12" Foreground="#6B7280" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding ScannedTemplate.Placeholders.Count, StringFormat={}{0} 个}" FontSize="12" FontWeight="SemiBold" Foreground="#1A2540" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 模板内容预览 -->
                        <Border Style="{StaticResource Card}" Grid.Row="1" Margin="0,4,0,0">
                            <StackPanel>
                                <Border Style="{StaticResource CardHeader}">
                                    <DockPanel>
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                            <TextBlock Text="📋 模板内容预览" FontSize="12" FontWeight="SemiBold" Foreground="#1A2540"/>
                                            <TextBlock Text="{Binding ScannedTemplate.Placeholders.Count, StringFormat=占位符 {0} 个 · }" FontSize="11" Foreground="#9CA3AF" Margin="12,0,0,0"/>
                                            <TextBlock Text="{Binding ScannedTemplate.UnmatchedCount, StringFormat=未匹配 {0} 个}" FontSize="11" Foreground="#9CA3AF"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                            <Button Content="🔄 重新加载预览" Command="{Binding ReloadTemplateCmd}"
                                                    IsEnabled="{Binding HasTemplate}"
                                                    Style="{StaticResource AccentBtn}" Margin="0,0,8,0" FontSize="11" Padding="10,3"/>
                                            <Button Content="📄 用 Excel/WPS 打开模板" Command="{Binding OpenTemplateInExcelCmd}"
                                                    IsEnabled="{Binding HasTemplate}"
                                                    Style="{StaticResource PrimaryBtn}" FontSize="11" Padding="10,3"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <DataGrid x:Name="TemplateContentDataGrid" ItemsSource="{Binding TemplateContentRows}" Margin="6,4" Height="220"
                                          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                          HeadersVisibility="All" GridLinesVisibility="All"
                                          RowHeaderWidth="80" CanUserResizeColumns="True">
                                    <DataGrid.RowHeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding RowLabel}" Padding="4" FontSize="10" Foreground="#6B7280"/>
                                        </DataTemplate>
                                    </DataGrid.RowHeaderTemplate>
                                    <DataGrid.CellStyle>
                                        <Style TargetType="DataGridCell">
                                            <Setter Property="ToolTip" Value="{Binding}" />
                                        </Style>
                                    </DataGrid.CellStyle>
                                </DataGrid>
                                <Border Background="#FDFBF5" BorderBrush="#D4A256" BorderThickness="0,2,0,0" Padding="14,8">
                                    <TextBlock Text="💡 提示：黄色高亮为包含 {占位符} 的单元格。点击「📄 用 Excel/WPS 打开模板」可获得完整格式（合并单元格/行高列宽/字体颜色等）预览与编辑，保存后本程序自动重载。" FontSize="11" Foreground="#8B6914" TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ③ 预览阶段 -->
                <Border Visibility="{Binding CurrentStep, Converter={StaticResource StepVisConv}, ConverterParameter={x:Static m:WizardStep.Preview}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 说明栏 -->
                        <Border Grid.Row="0" Background="#FDFBF5" BorderBrush="#D4A256" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,8">
                            <DockPanel LastChildFill="True">
                                <TextBlock Text="🔍" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <Button DockPanel.Dock="Right" Content="🔄 重新试生成" Command="{Binding ReTrialGenerateCmd}" Style="{StaticResource PrimaryBtn}"/>
                                <StackPanel>
                                    <TextBlock Text="试生成第 1 条数据 · 预览填充效果" FontSize="13" FontWeight="SemiBold" Foreground="#8B6914"/>
                                    <TextBlock Text="系统已用第1行数据填充模板生成临时预览文件，请检查占位符替换、数据类型、样式保留是否符合预期" FontSize="11" Foreground="#B8860B" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- 未试生成时的提示 -->
                        <Border Grid.Row="1" Style="{StaticResource Card}" Visibility="{Binding HasPreviewResult, Converter={StaticResource BoolVisConv}, ConverterParameter=!}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,40">
                                <TextBlock Text=" awaited" Visibility="Collapsed"/>
                                <TextBlock Text="点击下方按钮试生成第1条数据预览效果" FontSize="14" Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                                <Button Content="🚀 试生成第1条" Command="{Binding TrialGenerateCmd}" Style="{StaticResource PrimaryBtn}" Padding="24,10" FontSize="14" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- 试生成结果 -->
                        <Grid Grid.Row="1" Visibility="{Binding HasPreviewResult, Converter={StaticResource BoolVisConv}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- 生成信息 -->
                            <Border Style="{StaticResource Card}" Grid.Row="0" Margin="0,0,0,4">
                                <StackPanel>
                                    <Border Style="{StaticResource CardHeader}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📄 预览文件" FontSize="12" FontWeight="SemiBold" Foreground="#1A2540"/>
                                            <TextBlock Text="{Binding PreviewResult.TempFileName}" FontFamily="Consolas" FontSize="12" FontWeight="SemiBold" Foreground="#D4A256" Margin="12,0,0,0"/>
                                            <Border Margin="12,0,0,0" Background="#FEF3C7" BorderBrush="#FBBF24" BorderThickness="1" CornerRadius="8" Padding="6,1">
                                                <TextBlock Text="临时文件 · 生成时清除" FontSize="10" Foreground="#B8860B"/>
                                            </Border>
                                            <Button Content="📂 用Excel打开" Command="{Binding OpenPreviewFileCmd}" Style="{StaticResource SecondaryBtn}" Margin="12,0,0,0" Padding="8,2"/>
                                        </StackPanel>
                                    </Border>
                                    <StackPanel Margin="14,8" Orientation="Horizontal">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                                            <TextBlock Text="数据行：" FontSize="11" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding PreviewResult.SourceRowIndex, StringFormat=第{0}行}" FontSize="11" FontWeight="SemiBold" Foreground="#1A2540" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                                            <TextBlock Text="Sheet数：" FontSize="11" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding PreviewResult.SheetCount, StringFormat={}{0} 个}" FontSize="11" FontWeight="SemiBold" Foreground="#1A2540" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                                            <TextBlock Text="占位符替换：" FontSize="11" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding PreviewResult.PlaceholderReplacedCount, StringFormat={}{0} 个}" FontSize="11" FontWeight="SemiBold" Foreground="#10B981" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="公式转值：" FontSize="11" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding PreviewResult.FormulaConvertedCount, StringFormat={}{0} 个}" FontSize="11" FontWeight="SemiBold" Foreground="#10B981" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- 填充预览：显示填充了数据的模板内容 -->
                            <Border Style="{StaticResource Card}" Grid.Row="1" Margin="0,4,0,0">
                                <StackPanel>
                                    <Border Style="{StaticResource CardHeader}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📋 填充效果预览" FontSize="12" FontWeight="SemiBold" Foreground="#1A2540"/>
                                            <TextBlock Text="{Binding PreviewResult.PlaceholderReplacedCount, StringFormat=占位符替换 {0} 个 · }" FontSize="11" Foreground="#9CA3AF" Margin="12,0,0,0"/>
                                            <TextBlock Text="{Binding PreviewResult.FormulaConvertedCount, StringFormat=公式转值 {0} 个 · }" FontSize="11" Foreground="#9CA3AF"/>
                                            <TextBlock Text="{Binding PreviewResult.SourceRowIndex, StringFormat=第 {0} 行数据}" FontSize="11" Foreground="#9CA3AF"/>
                                        </StackPanel>
                                    </Border>
                                    <DataGrid x:Name="FilledPreviewDataGrid" ItemsSource="{Binding FilledContentRows}" Margin="6,4" Height="220"
                                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                              HeadersVisibility="All" GridLinesVisibility="All"
                                              RowHeaderWidth="80" CanUserResizeColumns="True">
                                        <DataGrid.RowHeaderTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding RowLabel}" Padding="4" FontSize="10" Foreground="#6B7280"/>
                                            </DataTemplate>
                                        </DataGrid.RowHeaderTemplate>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- 确认栏 -->
                        <Border Grid.Row="2" Background="#1A2540" CornerRadius="6" Padding="14,10" Margin="0,8,0,0"
                                Visibility="{Binding HasPreviewResult, Converter={StaticResource BoolVisConv}}">
                            <DockPanel LastChildFill="True">
                                <Button DockPanel.Dock="Right" Content="✓ 确认效果 · 进入生成 →" Command="{Binding ConfirmPreviewCmd}" Style="{StaticResource SuccessBtn}" Padding="20,8" FontSize="13" FontWeight="SemiBold"/>
                                <Button DockPanel.Dock="Right" Content="✎ 返回模板修改" Command="{Binding GoPrevCmd}" Style="{StaticResource SecondaryBtn}" Margin="8,0,0,0" Background="Transparent" Foreground="#F0E6D2" BorderBrush="#4A5568"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="💡" Foreground="#D4A256" FontSize="16" Margin="0,0,8,0"/>
                                    <TextBlock Text="请确认以上填充效果是否符合预期？" FontSize="13" Foreground="#F0E6D2" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Text="确认后进入生成阶段设置命名规则并全部生成" FontSize="10" Foreground="#9CA3AF" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ④ 生成阶段 -->
                <Border Visibility="{Binding CurrentStep, Converter={StaticResource StepVisConv}, ConverterParameter={x:Static m:WizardStep.Generate}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 基本设置 -->
                        <Border Style="{StaticResource Card}" Grid.Row="0">
                            <StackPanel>
                                <Border Style="{StaticResource CardHeader}">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="20" Height="20" CornerRadius="10" Background="#1A2540">
                                            <TextBlock Text="1" Foreground="#D4A256" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="基本设置" FontSize="13" FontWeight="SemiBold" Foreground="#1A2540" Margin="8,0,0,0"/>
                                        <TextBlock Text="保存位置 · 形式 · 命名规则" FontSize="11" Foreground="#9CA3AF" Margin="12,0,0,0"/>
                                    </StackPanel>
                                </Border>
                                <StackPanel Margin="14,10">
                                    <!-- 保存文件名 + 保存形式 + 自动创建提示（一行） -->
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="* 保存文件名：" VerticalAlignment="Center" FontSize="12"/>
                                        <TextBox Grid.Column="1" Text="{Binding CustomOutputFolder}" Margin="8,0" ToolTip="选择保存位置，将自动在此创建日期格式子文件夹"/>
                                        <Button Grid.Column="2" Content="浏览..." Command="{Binding BrowseFolderCmd}" Style="{StaticResource SecondaryBtn}" Padding="8,3" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="3" Text="* 保存形式：" VerticalAlignment="Center" FontSize="12" Margin="8,0,0,0"/>
                                        <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="8,0,0,0">
                                            <RadioButton Content="📁 多文件（每一行一个工作簿）" IsChecked="{Binding OutputMode, Converter={StaticResource EnumEqConv}, ConverterParameter={x:Static m:OutputMode.MultiFilePerRow}}" Margin="0,0,12,0"/>
                                            <RadioButton Content="📑 单文件（全部行一个工作簿）" IsChecked="{Binding OutputMode, Converter={StaticResource EnumEqConv}, ConverterParameter={x:Static m:OutputMode.SingleFileMultiSheet}}"/>
                                        </StackPanel>
                                        <Border Grid.Column="5" Background="#ECFDF5" BorderBrush="#10B981" BorderThickness="0" Padding="8,4" CornerRadius="4" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="✅ 自动创建日期子文件夹（yyyyMMdd_HHmmss）" FontSize="10" Foreground="#065F46"/>
                                        </Border>
                                    </Grid>
                                    <Border Height="1" Background="#F0F2F5" Margin="0,8"/>
                                    <!-- 命名规则 + 文件名预览 同排 -->
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="* 主命名列：" VerticalAlignment="Center" FontSize="12"/>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding Columns}" SelectedItem="{Binding PrimaryNamingColumn}" DisplayMemberPath="DisplayName" Margin="6,0"/>
                                        <TextBlock Grid.Column="2" Text="次命名列：" VerticalAlignment="Center" FontSize="12" Margin="12,0,0,0" Foreground="#6B7280"/>
                                        <ComboBox Grid.Column="3" ItemsSource="{Binding Columns}" SelectedItem="{Binding SecondaryNamingColumn}" DisplayMemberPath="DisplayName" Margin="6,0"/>
                                        <TextBlock Grid.Column="4" Text="分隔符：" VerticalAlignment="Center" FontSize="12" Margin="12,0,0,0"/>
                                        <TextBox Grid.Column="5" Text="{Binding NamingSeparator, UpdateSourceTrigger=PropertyChanged}" MaxLength="3" HorizontalContentAlignment="Center"/>
                                        <TextBlock Grid.Column="6" Text="重名处理：" VerticalAlignment="Center" FontSize="12" Margin="12,0,0,0"/>
                                        <ComboBox Grid.Column="7" SelectedIndex="0" Margin="6,0,0,0">
                                            <ComboBoxItem Content="自动追加序号"/>
                                            <ComboBoxItem Content="提示用户处理"/>
                                        </ComboBox>
                                        <TextBlock Grid.Column="8" Text="预览：" Foreground="#9CA3AF" FontSize="11" VerticalAlignment="Center" Margin="16,0,6,0"/>
                                        <TextBlock Grid.Column="9" Text="{Binding FileNamePreview}" Foreground="#D4A256" FontFamily="Consolas" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding FileNamePreview}"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 高级设置 -->
                        <Border Style="{StaticResource Card}" Grid.Row="1" Margin="0,4,0,0">
                            <Expander Header="⚙️ 高级设置（数据写入与生成行为）" FontSize="12" FontWeight="SemiBold" Foreground="#1A2540" Padding="14,6" IsExpanded="False">
                                <Grid Margin="14,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Text="数据写入" FontSize="11" FontWeight="SemiBold" Foreground="#B87333" Margin="0,0,0,4"/>
                                        <CheckBox Content="保留 DateTime 类型" IsChecked="{Binding WriteSettings.PreserveDateTimeType}"/>
                                        <CheckBox Content="保留数值类型" IsChecked="{Binding WriteSettings.PreserveNumericType}"/>
                                        <CheckBox Content="长数字（&gt;11位）自动转文本" IsChecked="{Binding WriteSettings.AutoLongNumberAsText}"/>
                                        <CheckBox Content="空值写入DBNull（真正清空）" IsChecked="{Binding WriteSettings.WriteDbNullForEmpty}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="生成行为" FontSize="11" FontWeight="SemiBold" Foreground="#B87333" Margin="0,0,0,4"/>
                                        <CheckBox Content="生成后自动打开输出目录" IsChecked="True"/>
                                        <CheckBox Content="记住本次配置" IsChecked="True"/>
                                        <CheckBox Content="缺失列显示警告并留空" IsChecked="True"/>
                                        <CheckBox Content="占位符大小写敏感" IsChecked="True"/>
                                    </StackPanel>
                                </Grid>
                            </Expander>
                        </Border>

                        <!-- 预校验 + 进度 + 日志 -->
                        <Grid Grid.Row="2" Margin="0,4,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1.3*"/>
                            </Grid.ColumnDefinitions>
                            <!-- 进度区 -->
                            <Border Style="{StaticResource Card}" Grid.Row="0" Grid.Column="0" Margin="0,0,4,0">
                                <StackPanel>
                                    <Border Style="{StaticResource CardHeader}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📊 生成进度" FontSize="12" FontWeight="SemiBold" Foreground="#1A2540"/>
                                            <TextBlock Text="{Binding ValidationResult.SummaryText, FallbackValue=请先校验}" FontSize="11" Foreground="#6B7280" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <StackPanel Margin="14,10">
                                        <ProgressBar Value="{Binding Progress.ProgressPercent, Mode=OneWay, FallbackValue=0}" Height="12" Minimum="0" Maximum="100" Foreground="#D4A256" Margin="0,0,0,6"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Progress.StatusText, FallbackValue=等待开始生成}" FontSize="11" Foreground="#374151"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Button Content="🔍 校验" Command="{Binding ValidateCmd}" Style="{StaticResource SecondaryBtn}" Margin="0,0,8,0"/>
                                            <Button Content="✅ 立即生成" Command="{Binding GenerateCmd}" Style="{StaticResource SuccessBtn}" Margin="0,0,8,0"/>
                                            <Button Content="⛔ 取消" Command="{Binding CancelCmd}" Style="{StaticResource SecondaryBtn}"/>
                                            <Button Content="📂 打开目录" Command="{Binding OpenOutputFolderCmd}" Style="{StaticResource SecondaryBtn}" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <!-- 日志区 -->
                            <Border Style="{StaticResource Card}" Grid.Row="0" Grid.Column="1" Margin="4,0,0,0">
                                <StackPanel>
                                    <Border Style="{StaticResource CardHeader}">
                                        <TextBlock Text="📜 实时日志" FontSize="12" FontWeight="SemiBold" Foreground="#1A2540"/>
                                    </Border>
                                    <ListBox ItemsSource="{Binding Progress.Logs, FallbackValue={x:Null}}" FontFamily="Consolas" FontSize="11" Height="160" BorderThickness="0" Background="#1A1F2E" Foreground="#A0AEC0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- ========== 底部操作栏 ========== -->
        <Border Grid.Row="3" Background="White" CornerRadius="6" Padding="14,10" Margin="0,8,0,0" BorderBrush="#E8EAF0" BorderThickness="1">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="8" Height="8" CornerRadius="4" Background="#D4A256" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock FontSize="11" Foreground="#6B7280" VerticalAlignment="Center">
                        <Run Text="阶段 "/><Run Text="{Binding CurrentStepText, Mode=OneWay}"/><Run Text=" / "/><Run Text="4"/><Run Text=" · "/>
                        <Run Text="{Binding StageStatusText, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="← 上一步" Command="{Binding GoPrevCmd}" Style="{StaticResource SecondaryBtn}" Margin="0,0,8,0"/>
                    <!-- 非最终步骤：显示"下一步" -->
                    <Button Content="下一步 →" Command="{Binding GoNextCmd}" Style="{StaticResource PrimaryBtn}" Padding="20,8"
                            Visibility="{Binding IsGenerateStep, Converter={StaticResource BoolVisConv}, ConverterParameter=!}"/>
                    <!-- 最终步骤：显示"关闭" -->
                    <Button Content="✓ 关闭" Click="CloseApp_Click" Style="{StaticResource PrimaryBtn}" Padding="20,8"
                            Visibility="{Binding IsGenerateStep, Converter={StaticResource BoolVisConv}}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
