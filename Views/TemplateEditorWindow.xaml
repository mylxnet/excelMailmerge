<Window x:Class="ExcelMailMerge.Views.TemplateEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="✨ 模板编辑器 · 用 Excel/WPS 打开编辑" Height="680" Width="1060"
        WindowStartupLocation="CenterOwner" Background="#F5F6FA">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="BorderBrush" Value="#D0D5DD"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="SuccessBtn" TargetType="Button">
            <Setter Property="Background" Value="#059669"/>
        </Style>
        <Style x:Key="BigOpenBtn" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="28,18"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ========== 标题 ========== -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#7C3AED" CornerRadius="6" Padding="14,10" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="✨ 模板编辑器 · 用 Excel/WPS 打开编辑" FontSize="18" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="方案 B：模板编辑交给 Excel/WPS 自己处理 · 本窗口负责：打开模板 + 预览 + 列名复制" FontSize="12" Foreground="#E9D5FF" Margin="0,3"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="🔒 不再高仿 Excel 渲染：格式 100% 还原" FontSize="12" Foreground="#F3E8FF" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ========== 左侧：列名面板 ========== -->
        <Border Grid.Row="1" Grid.Column="0" Background="White" CornerRadius="6" BorderBrush="#E5E7EB" BorderThickness="1" Margin="0,0,8,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="#F5F3FF" CornerRadius="6,6,0,0" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="📋 数据源列名" FontWeight="Bold" FontSize="14" Foreground="#5B21B6"/>
                        <TextBlock Text="点击 = 复制 {列名} 到剪贴板" FontSize="11" Foreground="#7C3AED" Margin="0,2"/>
                    </StackPanel>
                </Border>
                <TextBox x:Name="SearchBox" DockPanel.Dock="Top" TextChanged="SearchBox_TextChanged" Margin="8,8,8,4" Background="#FAFAFA" ToolTip="搜索列名"/>
                <Border DockPanel.Dock="Bottom" CornerRadius="0,0,6,6" Padding="8" Background="#F9FAFB">
                    <TextBlock TextWrapping="Wrap" Foreground="#6B7280" FontSize="11">
                        💡 使用流程：<LineBreak/>
                        ① 点右侧「📄 打开模板」<LineBreak/>
                        ② Excel/WPS 打开模板后，点左侧某列名复制<LineBreak/>
                        ③ 在 Excel 里选中目标单元格 Ctrl+V 粘贴<LineBreak/>
                        ④ 编辑完 Ctrl+S 保存，本窗口自动重载
                    </TextBlock>
                </Border>
                <ListBox x:Name="ColumnListBox" ScrollViewer.VerticalScrollBarVisibility="Auto" BorderThickness="0" Margin="4,0" MouseLeftButtonDown="ColumnListBox_MouseLeftButtonDown">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="2"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="bd" Background="Transparent" CornerRadius="5" Margin="2,1">
                                            <Grid Margin="6,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" FontSize="13"/>
                                                <Button Grid.Column="1" Content="📋" Style="{StaticResource SecondaryBtn}" Padding="5,0" FontSize="11"
                                                        Click="CopyPlaceholder_Click" CommandParameter="{Binding DisplayName}" ToolTip="复制 {列名}"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#F5F3FF"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#7C3AED"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ========== 右侧：打开按钮 + 极简预览 ========== -->
        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 大按钮区 -->
            <Border Grid.Row="0" Background="White" CornerRadius="6" BorderBrush="#E5E7EB" BorderThickness="1" Margin="0,0,0,6">
                <StackPanel Orientation="Horizontal" Margin="16,14">
                    <Button Content="📄 用 Excel/WPS 打开模板" Click="OpenInExcel_Click" Style="{StaticResource BigOpenBtn}" MinWidth="260"/>
                    <StackPanel VerticalAlignment="Center" Margin="16,0,0,0">
                        <TextBlock Text="模板路径：" FontWeight="SemiBold" FontSize="12" Foreground="#374151"/>
                        <TextBlock x:Name="TplPathText" Text="{Binding TemplatePath, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="11" Foreground="#6B7280" TextWrapping="Wrap" MaxWidth="500"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 预览标题栏 -->
            <Border Grid.Row="1" Background="White" CornerRadius="6,6,0,0" BorderBrush="#E5E7EB" BorderThickness="1" Margin="0,0,0,0">
                <Grid Margin="12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📋 极简预览（只看文本和占位符匹配，样式请在 Excel 中查看）" FontSize="12" FontWeight="SemiBold" Foreground="#1A2540"/>
                        <TextBlock x:Name="StatText" Text="" FontSize="11" Foreground="#9CA3AF" Margin="12,0,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="🔄 重新加载" Click="Reload_Click" Style="{StaticResource SecondaryBtn}" Padding="10,3"/>
                </Grid>
            </Border>

            <!-- 预览 DataGrid -->
            <Border Grid.Row="2" Background="White" CornerRadius="0,0,6,6" BorderBrush="#E5E7EB" BorderThickness="1,0,1,1" ClipToBounds="True">
                <Grid>
                    <DataGrid x:Name="PreviewGrid" ItemsSource="{Binding PreviewRows, RelativeSource={RelativeSource AncestorType=Window}}"
                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              HeadersVisibility="All" GridLinesVisibility="All"
                              RowHeaderWidth="60" CanUserResizeColumns="True"/>
                    <Border x:Name="EmptyHint" Background="#FFFBEB" BorderBrush="#D4A256" BorderThickness="1" Margin="12" CornerRadius="4" Padding="12" VerticalAlignment="Top">
                        <TextBlock Text="💡 还没有模板预览。请先点「📄 用 Excel/WPS 打开模板」，编辑完保存后本窗口会自动重载。" FontSize="11" Foreground="#92400E" TextWrapping="Wrap"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ========== 底部操作栏 ========== -->
        <Border Grid.Row="2" Grid.ColumnSpan="2" Background="White" CornerRadius="6" Padding="12,8" BorderBrush="#E5E7EB" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#6B7280" FontSize="12"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="❌ 取消并关闭" Style="{StaticResource SecondaryBtn}" Click="Cancel_Click"/>
                    <Button Content="✅ 模板编辑完成，返回主界面" Style="{StaticResource SuccessBtn}" Click="Finish_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
